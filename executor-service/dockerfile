# Fase 1: Immagine di base
# Utilizziamo un'immagine Python ufficiale, versione slim per ridurre le dimensioni.
FROM python:3.11-slim

# Imposta la directory di lavoro all'interno del container
WORKDIR /app

# Variabili d'ambiente per ottimizzare l'esecuzione di Python
ENV PYTHONDONTWRITEBYTECODE 1
ENV PYTHONUNBUFFERED 1

# Fase 2: Installazione delle dipendenze di sistema e Python
# Aggiorniamo apt e installiamo gcc, necessario per compilare il codice C.
RUN apt-get update && \
    apt-get install -y gcc && \
    rm -rf /var/lib/apt/lists/*

# Copiamo il file dei requisiti e installiamo le dipendenze Python
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Fase 3: Copia del codice dell'applicazione
# Copiamo il file del server Flask nella directory di lavoro
COPY main.py .

# Fase 4: Esposizione della porta e comando di avvio
# Esponiamo la porta 8080, su cui Gunicorn si metterà in ascolto
EXPOSE 8080

# Comando per avviare il server con Gunicorn.
# Usiamo il worker 'gevent' ottimizzato per I/O asincrono e WebSockets.
# Il flag --timeout 0 disabilita il timeout del worker, essenziale per
# mantenere attive le connessioni WebSocket a lunga durata.
CMD ["gunicorn", "--bind", "0.0.0.0:8080", "--workers", "1", "--worker-class", "gevent", "--timeout", "0", "main:app"]
